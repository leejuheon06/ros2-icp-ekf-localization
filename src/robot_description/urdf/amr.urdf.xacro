<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="icp_ekf_amr">

    <!-- ========================= -->
    <!-- Parameters -->
    <!-- ========================= -->

    <xacro:property name="base_length" value="0.60"/>
    <xacro:property name="base_width"  value="0.40"/>
    <xacro:property name="base_height" value="0.20"/>

    <xacro:property name="wheel_radius" value="0.08"/>
    <xacro:property name="wheel_width"  value="0.04"/>

    <!-- ========================= -->
    <!-- BASE FOOTPRINT -->
    <!-- ========================= -->

    <link name="base_footprint"/>

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>

        <!-- wheel radius 만큼 위쪽 -->
        <origin xyz="0 0 0.08"
                rpy="0 0 0"/>
    </joint>

    <!-- ========================= -->
    <!-- BASE LINK -->
    <!-- ========================= -->

    <link name="base_link">

        <visual>
            <origin xyz="0 0 0.10"
                    rpy="0 0 0"/>

            <geometry>
                <box size="${base_length}
                           ${base_width}
                           ${base_height}"/>
            </geometry>

            <material name="body">
                <color rgba="0.3 0.5 0.8 1.0"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0.10"
                    rpy="0 0 0"/>

            <geometry>
                <box size="${base_length}
                           ${base_width}
                           ${base_height}"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0.10"
                    rpy="0 0 0"/>

            <mass value="15.0"/>    # 무게(kg)

            <inertia
                ixx="0.25"
                ixy="0.0"
                ixz="0.0"
                iyy="0.50"
                iyz="0.0"
                izz="0.60"/>
        </inertial>

    </link>

    <!-- ========================= -->
    <!-- LEFT WHEEL -->
    <!-- ========================= -->

    <link name="left_wheel_link">

        <visual>
            <geometry>
                <cylinder
                    radius="${wheel_radius}"
                    length="${wheel_width}"/>
            </geometry>

            <material name="wheel">
                <color rgba="0.1 0.1 0.1 1.0"/>
            </material>
        </visual>

        <collision>
            <geometry>
                <cylinder
                    radius="${wheel_radius}"
                    length="${wheel_width}"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="1.0"/>

            <inertia
                ixx="0.003"
                ixy="0.0"
                ixz="0.0"
                iyy="0.003"
                iyz="0.0"
                izz="0.003"/>
        </inertial>

    </link>

    <joint name="left_wheel_joint"
           type="continuous">

        <parent link="base_link"/>
        <child link="left_wheel_link"/>

        <origin xyz="0 0.22 0"
                rpy="1.5708 0 0"/>

        <axis xyz="0 0 1"/>

    </joint>

    <gazebo reference="left_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    </gazebo>

    <!-- ========================= -->
    <!-- RIGHT WHEEL -->
    <!-- ========================= -->

    <link name="right_wheel_link">

        <visual>
            <geometry>
                <cylinder
                    radius="${wheel_radius}"
                    length="${wheel_width}"/>
            </geometry>

            <material name="wheel"/>
        </visual>

        <collision>
            <geometry>
                <cylinder
                    radius="${wheel_radius}"
                    length="${wheel_width}"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="1.0"/>

            <inertia
                ixx="0.003"
                ixy="0.0"
                ixz="0.0"
                iyy="0.003"
                iyz="0.0"
                izz="0.003"/>
        </inertial>

    </link>

    <joint name="right_wheel_joint"
           type="continuous">

        <parent link="base_link"/>
        <child link="right_wheel_link"/>

        <origin xyz="0 -0.22 0"
                rpy="1.5708 0 0"/>

        <axis xyz="0 0 1"/>

    </joint>

    <gazebo reference="right_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    </gazebo>

    <!-- ========================= -->
    <!-- LASER -->
    <!-- ========================= -->

    <link name="laser_link">

        <visual>
            <geometry>
                <cylinder
                    radius="0.05"
                    length="0.04"/>
            </geometry>

            <material name="laser">
                <color rgba="0.8 0.1 0.1 1.0"/>
            </material>
        </visual>

    </link>

    <joint name="laser_joint"
           type="fixed">

        <parent link="base_link"/>
        <child link="laser_link"/>

        <origin xyz="0.15 0 0.25"
                rpy="0 0 0"/>

    </joint>

    <!-- ========================= -->
    <!-- IMU -->
    <!-- ========================= -->

    <link name="imu_link">

        <visual>
            <geometry>
                <box size="0.04 0.04 0.02"/>
            </geometry>

            <material name="imu">
                <color rgba="0.1 0.8 0.1 1.0"/>
            </material>
        </visual>

    </link>

    <joint name="imu_joint"
           type="fixed">

        <parent link="base_link"/>
        <child link="imu_link"/>

        <origin xyz="0 0 0.20"
                rpy="0 0 0"/>

    </joint>

    <!-- ========================= -->
    <!-- FRONT CASTER -->
    <!-- ========================= -->

    <link name="front_caster_link">

    <visual>
        <geometry>
        <sphere radius="0.04"/>
        </geometry>

        <material name="caster">
        <color rgba="0.2 0.2 0.2 1.0"/>
        </material>
    </visual>

    <collision>
        <geometry>
        <sphere radius="0.04"/>
        </geometry>
    </collision>

    <inertial>
        <mass value="0.2"/>

        <inertia
        ixx="0.0001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0001"
        iyz="0.0"
        izz="0.0001"/>
    </inertial>

    </link>

    <joint name="front_caster_joint"
        type="fixed">

    <parent link="base_link"/>
    <child link="front_caster_link"/>

    <origin xyz="0.22 0 -0.04"
            rpy="0 0 0"/>

    </joint>

    <gazebo reference="front_caster_link">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
    </gazebo>

    <!-- ========================= -->
    <!-- REAR CASTER -->
    <!-- ========================= -->

    <link name="rear_caster_link">

    <visual>
        <geometry>
        <sphere radius="0.04"/>
        </geometry>

        <material name="caster"/>
    </visual>

    <collision>
        <geometry>
        <sphere radius="0.04"/>
        </geometry>
    </collision>

    <inertial>
        <mass value="0.2"/>

        <inertia
        ixx="0.0001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0001"
        iyz="0.0"
        izz="0.0001"/>
    </inertial>

    </link>

    <joint name="rear_caster_joint"
        type="fixed">

    <parent link="base_link"/>
    <child link="rear_caster_link"/>

    <origin xyz="-0.22 0 -0.04"
            rpy="0 0 0"/>

    </joint>

    <gazebo reference="rear_caster_link">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
    </gazebo>



</robot>